# Port for the backend server (Render automatically provides PORT)
PORT=5000

# Your Supabase Project Settings (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# JWT Secret for cookie authentication (any long random 32+ character string)
JWT_SECRET=super_secret_jwt_key_tahwissa_2026_change_in_production

# Frontend Production URL for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Environment
NODE_ENV=production
